# URL pública del sitio (metadata, robots, sitemap)
NEXT_PUBLIC_SITE_URL=https://festeka.co

# Mientras sea "true" (o no esté definida), robots.txt bloquea la indexación: el sitio usa datos dummy.
# Poner "false" en el lanzamiento (ROADMAP S8-07).
NEXT_PUBLIC_DEMO=true

# A/B del hero (docs/10-experimento-ab-hero.md)
# off = todos ven la variante A
HERO_EXPERIMENT=on
# Fuerza una variante para todos (útil en previews): a | b
# HERO_FORCE=b

# API Go (desde el sprint 1)
# NEXT_PUBLIC_API_URL=https://api.festeka.co
